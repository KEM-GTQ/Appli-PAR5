PORT=3001

# MySQL. Tant que l'hôte, l'utilisateur ou la base sont vides, l'API n'écrit rien.
# Le PDF reste dans SharePoint. En local : hôte localhost, port 3306, base par5.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Application Entra en identifiants d'application (permission d'application, personne n'est connecté).
# Le téléphone ne voit jamais ces valeurs.
GRAPH_TENANT_ID=0576aa1c-efa8-4161-b208-5e84d3216908
GRAPH_CLIENT_ID=83c11de8-30e6-47fb-b241-eb3582f8e930
GRAPH_CLIENT_SECRET=

# Site SharePoint. Un lien de bibliothèque convient aussi : le dossier est lu dans le paramètre id.
SHAREPOINT_SITE_URL=https://genitique.sharepoint.com/sites/PowerPlatform-Dev/Documents%20partages/Forms/AllItems.aspx?id=%2Fsites%2FPowerPlatform%2DDev%2FDocuments%20partages%2FCursor
# Dossier dans la bibliothèque par défaut du site. Cette valeur gagne si l'adresse contient déjà un dossier.
SHAREPOINT_FOLDER=Cursor
# Identifiant Graph du site, utilisé seulement si SHAREPOINT_SITE_URL est vide.
SHAREPOINT_SITE_ID=
# Optionnel. À remplir pour déposer dans une autre bibliothèque que le lecteur par défaut.
SHAREPOINT_DRIVE_ID=
# Liste des projets actifs. Autre site que le dossier des PDF :
# https://genitique.sharepoint.com/Lists/Projets%202/AllItems.aspx
# Le menu affiche la colonne Projet, seulement quand État vaut Actif.
SHAREPOINT_PROJETS_SITE_URL=https://genitique.sharepoint.com/Lists/Projets%202/AllItems.aspx
SHAREPOINT_LISTE_PROJETS=Projets 2
SHAREPOINT_CHAMP_PROJET=Projet
SHAREPOINT_CHAMP_ETAT=État
SHAREPOINT_ETAT_ACTIF=Actif

# Origines autorisées à appeler l'API, séparées par des virgules.
# Vide : le navigateur servi par la même origine (le proxy de Vite, ou l'API qui sert l'application).
CORS_ORIGIN=

# Adresse de l'API vue par l'application. Vide : même origine, chemin /api
# (le proxy de Vite en développement).
VITE_API_URL=

# Connexion des travailleurs (même application Entra, flux code + PKCE).
# L'identifiant et le locataire suffisent : le téléphone demande alors le compte professionnel.
# L'URI de redirection à déclarer sur la plateforme SPA : http://localhost:5173/Appli-PAR5/
# VITE_ENTRA_API_SCOPE reste vide tant qu'aucun scope d'API n'est exposé.
# L'audience côté API est alors l'identifiant de l'application (jeton d'identité).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=

ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# Barrière légère pour POST /api/par5, utilisée seulement sans Entra.
# Si API_KEY est posé, construire l'application avec la même valeur dans VITE_API_KEY.
# La clé est dans l'application : garder aussi l'API sur un réseau privé.
API_KEY=
VITE_API_KEY=
